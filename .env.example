# Family Financial OS — Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# APP
# =============================================================================
APP_NAME=Family Financial OS
APP_VERSION=0.1.0
DEBUG=false

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL (Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/family_financial_os
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/family_financial_os

# SQLite (local development — default if DATABASE_URL is empty)
# DATABASE_URL=sqlite+aiosqlite:///family_financial.db
# DATABASE_SYNC_URL=sqlite:///family_financial.db

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS
# =============================================================================
# Comma-separated origins. Use * only for local development.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=memory

# =============================================================================
# POSTGRES (Docker Compose)
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=family_financial_os
