<template>
  <div class="goals-page">
    <div class="page-header">
      <h2 class="page-title">Mis Metas</h2>
      <button class="btn btn-primary" @click="openCreateModal">
        + Nueva Meta
      </button>
    </div>

    <div v-if="loading" class="loading-state">
      <SkeletonLoader v-for="n in 2" :key="n" variant="card" />
    </div>

    <div v-else-if="error" class="error-state">
      <span>{{ error }}</span>
      <button class="btn btn-sm" @click="loadData">Reintentar</button>
    </div>

    <template v-else>
      <div class="summary-hero card">
        <div class="summary-stats">
          <div class="stat-item">
            <span class="stat-value">{{ activeGoals.length }}</span>
            <span class="stat-label">activas</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">${{ formatMoney(totalCurrent) }}</span>
            <span class="stat-label">acumulado</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">${{ formatMoney(totalTarget) }}</span>
            <span class="stat-label">objetivo</span>
          </div>
        </div>
        <div class="summary-bar-track">
          <div class="summary-bar-fill" :style="{ width: `${overallProgress}%` }"></div>
        </div>
        <span class="summary-pct">{{ overallProgress }}% del objetivo total</span>
      </div>

      <div v-if="activeGoals.length === 0" class="empty-state">
        <Target :size="48" class="empty-icon" />
        <p class="empty-text">Todavía no tienes metas</p>
        <p class="empty-hint">Crea tu primera meta para empezar a ahorrar</p>
        <button class="btn btn-primary empty-cta" @click="openCreateModal">
          + Crear mi primera meta
        </button>
      </div>

      <div v-if="activeGoals.length > 0" class="goals-toolbar">
        <div class="filter-group">
          <button class="filter-btn" :class="{ active: filterType === 'all' }" @click="filterType = 'all'">Todas</button>
          <button class="filter-btn" :class="{ active: filterType === 'savings' }" @click="filterType = 'savings'">Ahorro</button>
          <button class="filter-btn" :class="{ active: filterType === 'investment' }" @click="filterType = 'investment'">Inversión</button>
        </div>
        <select v-model="sortBy" class="sort-select">
          <option value="name">Nombre</option>
          <option value="priority">Prioridad</option>
          <option value="progress">Progreso</option>
          <option value="date">Fecha</option>
        </select>
      </div>

      <div class="goals-list">
        <div v-for="goal in activeGoals" :key="goal.id" :data-goal-id="goal.id" class="goal-card card" :class="{ expanded: expandedGoal?.id === goal.id, 'highlight-new': highlightedGoalId === goal.id }">
          <div class="goal-header">
            <span class="goal-icon">{{ goal.goal_type === 'investment' ? '📈' : '🎯' }}</span>
            <div class="goal-title">
              <h3 class="goal-name">{{ goal.name }}</h3>
              <span class="goal-type-badge" :class="goal.goal_type">
                {{ goal.goal_type === 'investment' ? 'Inversión' : 'Ahorro' }}
              </span>
              <span v-if="goal.priority" class="priority-badge" :class="goal.priority">
                {{ goal.priority === 'high' ? 'Alta' : goal.priority === 'medium' ? 'Media' : 'Baja' }}
              </span>
            </div>
          </div>

          <div class="goal-amounts">
            <div class="amount-row">
              <span class="amount-label">Tienes</span>
              <span class="amount-current">${{ formatMoney(goal.current_amount) }}</span>
            </div>
            <div class="amount-row">
              <span class="amount-label">Necesitas</span>
              <span class="amount-target">${{ formatMoney(goal.target_amount) }}</span>
            </div>
            <div class="amount-row highlight">
              <span class="amount-label">Faltan</span>
              <span class="amount-remaining">${{ formatMoney(goal.target_amount - goal.current_amount) }}</span>
            </div>
          </div>

          <div class="goal-progress">
            <div class="progress-bar-track">
              <div class="progress-bar-fill" :style="{ width: `${goalProgress(goal)}%` }"></div>
            </div>
            <span class="progress-pct">{{ goalProgress(goal) }}%</span>
          </div>

          <div v-if="goal.monthly_contribution" class="goal-monthly">
            <span class="monthly-label">Aporte mensual:</span>
            <span class="monthly-value">${{ formatMoney(goal.monthly_contribution) }}</span>
          </div>

          <div v-if="goal.target_date" class="goal-timeline">
            <Calendar :size="14" />
            <span>Para: {{ formatDate(goal.target_date) }}</span>
            <span v-if="monthsRemaining(goal)" class="months-remaining">
              ({{ monthsRemaining(goal) }} meses)
            </span>
          </div>

          <div v-if="goal.goal_type === 'investment' && goal.expected_return_rate" class="goal-projection">
            <div class="projection-header">
              <TrendingUp :size="14" />
              <span>Proyección</span>
            </div>
            <div class="projection-details">
              <span>Rendimiento: {{ goal.expected_return_rate }}% EA</span>
              <span v-if="goal.horizon_months">Horizonte: {{ goal.horizon_months }} meses</span>
            </div>
            <div v-if="goal.projected_value" class="projection-result">
              <span class="projection-label">Valor proyectado:</span>
              <span class="projection-amount">${{ formatMoney(goal.projected_value) }}</span>
            </div>
          </div>

          <div class="goal-actions">
            <button class="action-btn primary" @click="openContribution(goal)">
              + Aportar
            </button>
            <button class="action-btn secondary" @click="toggleDetails(goal)">
              {{ expandedGoal?.id === goal.id ? 'Cerrar' : 'Ver detalles' }}
            </button>
          </div>

          <div v-if="expandedGoal?.id === goal.id" class="goal-expanded">
            <div class="expanded-section">
              <h4 class="expanded-title">Acciones</h4>
              <div class="expanded-actions">
                <button class="expanded-btn" @click="openEditModal(goal)">
                  ✏️ Editar
                </button>
                <button class="expanded-btn danger" @click="confirmDelete(goal)">
                  🗑️ Eliminar
                </button>
              </div>
            </div>
            <div v-if="goal.history?.length" class="expanded-section">
              <h4 class="expanded-title">Historial de aportes</h4>
              <div class="history-list">
                <div v-for="entry in goal.history" :key="entry.id" class="history-item">
                  <span class="history-date">{{ formatDate(entry.contribution_date) }}</span>
                  <span class="history-amount">${{ formatMoney(entry.amount) }}</span>
                </div>
              </div>
            </div>
            <div v-else class="expanded-section">
              <p class="expanded-empty">Aún no hay aportes registrados</p>
            </div>
          </div>
        </div>
      </div>

      <div v-if="completedGoals.length" class="completed-section">
        <h3 class="section-title">Completadas</h3>
        <div class="goals-list">
          <div v-for="goal in completedGoals" :key="goal.id" class="goal-card card completed">
            <div class="goal-header">
              <span class="goal-icon">🎉</span>
              <div class="goal-title">
                <h3 class="goal-name">{{ goal.name }}</h3>
                <span class="goal-type-badge completed">Lograda</span>
              </div>
            </div>
            <div class="completed-details">
              <span class="completed-amount">${{ formatMoney(goal.target_amount) }} ahorrados</span>
              <span v-if="goal.target_date" class="completed-date">Meta: {{ formatDate(goal.target_date) }}</span>
            </div>
            <div class="goal-progress">
              <div class="progress-bar-track">
                <div class="progress-bar-fill full"></div>
              </div>
              <span class="progress-pct">100%</span>
            </div>
          </div>
        </div>
      </div>
    </template>

    <div v-if="showContributionModal" class="modal-overlay" @click="closeContribution" @keydown.escape="closeContribution" role="dialog" aria-modal="true" :aria-label="`Aportar a ${selectedGoal?.name}`">
      <div class="modal-content" @click.stop ref="contributionInput">
        <h3 class="modal-title">Aportar a "{{ selectedGoal?.name }}"</h3>
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label" for="contribution-amount">Monto a aportar</label>
            <div class="modal-amount-input" :class="{ error: contributionError }">
              <span class="modal-currency">$</span>
              <input
                id="contribution-amount"
                ref="contributionField"
                v-model="contributionAmount"
                type="number"
                class="modal-amount-field"
                placeholder="0"
                min="1"
                @input="validateContribution"
              />
            </div>
            <span v-if="contributionError" class="form-error">{{ contributionError }}</span>
          </div>
          <div class="form-group">
            <label class="form-label" for="contribution-date">Fecha del aporte</label>
            <input
              id="contribution-date"
              v-model="contributionDate"
              type="date"
              class="form-input"
            />
          </div>
        </div>
        <div class="modal-actions">
          <button class="btn-cancel" @click="closeContribution">Cancelar</button>
          <button
            class="btn-confirm"
            @click="submitContribution"
            :disabled="!contributionAmount || contributing || !!contributionError"
          >
            {{ contributing ? 'Guardando...' : 'Confirmar' }}
          </button>
        </div>
      </div>
    </div>

    <div v-if="showCreateModal" class="modal-overlay" @click="closeCreateModal" @keydown.escape="closeCreateModal" role="dialog" aria-modal="true" aria-label="Crear nueva meta">
      <div class="modal-content modal-wide" @click.stop>
        <h3 class="modal-title">Nueva meta</h3>
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label" for="goal-name">¿Qué estás juntando?</label>
            <input id="goal-name" v-model="newGoal.name" type="text" class="form-input" placeholder="Ej: Viaje, Fondo de emergencia, Nuevo carro" maxlength="100" />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="goal-target">¿Cuánto necesitas?</label>
              <div class="modal-amount-input">
                <span class="modal-currency">$</span>
                <input id="goal-target" v-model="newGoal.target_amount" type="number" class="modal-amount-field" placeholder="0" min="1" />
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="goal-monthly">¿Cuánto puedes ahorrar al mes?</label>
              <div class="modal-amount-input">
                <span class="modal-currency">$</span>
                <input id="goal-monthly" v-model="newGoal.monthly_contribution" type="number" class="modal-amount-field" placeholder="0" min="0" />
              </div>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="goal-date">¿Para cuándo?</label>
              <input id="goal-date" v-model="newGoal.target_date" type="date" class="form-input" />
            </div>
            <div class="form-group">
              <label class="form-label" for="goal-type">Tipo</label>
              <select id="goal-type" v-model="newGoal.goal_type" class="form-input">
                <option value="savings">Ahorro</option>
                <option value="investment">Inversión</option>
              </select>
            </div>
          </div>
          <div v-if="newGoal.goal_type === 'investment'" class="form-row">
            <div class="form-group">
              <label class="form-label" for="goal-return">Rendimiento esperado (% EA)</label>
              <input id="goal-return" v-model="newGoal.expected_return_rate" type="number" class="form-input" placeholder="Ej: 9" min="0" step="0.1" />
            </div>
            <div class="form-group">
              <label class="form-label" for="goal-horizon">Horizonte (meses)</label>
              <input id="goal-horizon" v-model="newGoal.horizon_months" type="number" class="form-input" placeholder="Ej: 24" min="1" />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="goal-priority">Prioridad</label>
            <select id="goal-priority" v-model="newGoal.priority" class="form-input">
              <option value="low">Baja</option>
              <option value="medium">Media</option>
              <option value="high">Alta</option>
            </select>
          </div>
        </div>
        <div class="modal-actions">
          <button class="btn-cancel" @click="closeCreateModal">Cancelar</button>
          <button
            class="btn-confirm"
            @click="submitCreateGoal"
            :disabled="!newGoal.name || !newGoal.target_amount || creating"
          >
            {{ creating ? 'Creando...' : 'Crear meta' }}
          </button>
        </div>
      </div>
    </div>

    <div v-if="showEditModal" class="modal-overlay" @click="closeEditModal" @keydown.escape="closeEditModal" role="dialog" aria-modal="true" aria-label="Editar meta">
      <div class="modal-content modal-wide" @click.stop>
        <h3 class="modal-title">Editar "{{ editingGoal?.name }}"</h3>
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label" for="edit-name">Nombre</label>
            <input id="edit-name" v-model="editForm.name" type="text" class="form-input" maxlength="100" />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="edit-target">Monto objetivo</label>
              <div class="modal-amount-input">
                <span class="modal-currency">$</span>
                <input id="edit-target" v-model="editForm.target_amount" type="number" class="modal-amount-field" min="1" />
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="edit-monthly">Aporte mensual</label>
              <div class="modal-amount-input">
                <span class="modal-currency">$</span>
                <input id="edit-monthly" v-model="editForm.monthly_contribution" type="number" class="modal-amount-field" min="0" />
              </div>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="edit-date">Fecha objetivo</label>
              <input id="edit-date" v-model="editForm.target_date" type="date" class="form-input" />
            </div>
            <div class="form-group">
              <label class="form-label" for="edit-priority">Prioridad</label>
              <select id="edit-priority" v-model="editForm.priority" class="form-input">
                <option value="low">Baja</option>
                <option value="medium">Media</option>
                <option value="high">Alta</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="edit-type">Tipo de meta</label>
            <select id="edit-type" v-model="editForm.goal_type" class="form-input">
              <option value="savings">Ahorro</option>
              <option value="investment">Inversión</option>
            </select>
          </div>
        </div>
        <div class="modal-actions">
          <button class="btn-cancel" @click="closeEditModal">Cancelar</button>
          <button class="btn-confirm" @click="submitEditGoal" :disabled="editing">
            {{ editing ? 'Guardando...' : 'Guardar cambios' }}
          </button>
        </div>
      </div>
    </div>

    <div v-if="showDeleteConfirm" class="modal-overlay" @click="showDeleteConfirm = false" @keydown.escape="showDeleteConfirm = false" role="alertdialog" aria-modal="true" aria-label="Confirmar eliminación">
      <div class="modal-content modal-small" @click.stop>
        <h3 class="modal-title">¿Eliminar "{{ deletingGoal?.name }}"?</h3>
        <p class="delete-warning">Esta acción no se puede deshacer. Se perderán todos los aportes registrados.</p>
        <div class="modal-actions">
          <button class="btn-cancel" @click="showDeleteConfirm = false">Cancelar</button>
          <button class="btn-confirm btn-danger" @click="submitDeleteGoal" :disabled="deleting">
            {{ deleting ? 'Eliminando...' : 'Eliminar' }}
          </button>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, onMounted, onUnmounted, nextTick } from 'vue'
import api from '@/services/api'
import SkeletonLoader from '@/components/SkeletonLoader.vue'
import { Target, Calendar, TrendingUp } from 'lucide-vue-next'

const loading = ref(true)
const error = ref(null)
const goals = ref([])
const filterType = ref('all')
const sortBy = ref('name')

const showContributionModal = ref(false)
const selectedGoal = ref(null)
const contributionAmount = ref('')
const contributionDate = ref(new Date().toISOString().split('T')[0])
const contributionError = ref('')
const contributing = ref(false)
const contributionField = ref(null)

const showCreateModal = ref(false)
const creating = ref(false)
const newGoal = ref({
  name: '',
  target_amount: '',
  monthly_contribution: '',
  target_date: '',
  goal_type: 'savings',
  expected_return_rate: '',
  horizon_months: '',
  priority: 'medium',
})

const expandedGoal = ref(null)
const highlightedGoalId = ref(null)

const showEditModal = ref(false)
const editingGoal = ref(null)
const editing = ref(false)
const editForm = ref({
  name: '',
  target_amount: '',
  monthly_contribution: '',
  target_date: '',
  priority: 'medium',
  goal_type: 'savings',
})

const showDeleteConfirm = ref(false)
const deletingGoal = ref(null)
const deleting = ref(false)

const activeGoals = computed(() => {
  let filtered = goals.value.filter(g => g.current_amount < g.target_amount)

  if (filterType.value !== 'all') {
    filtered = filtered.filter(g => g.goal_type === filterType.value)
  }

  const priorityOrder = { high: 0, medium: 1, low: 2 }
  return filtered.sort((a, b) => {
    switch (sortBy.value) {
      case 'priority': return (priorityOrder[a.priority] ?? 1) - (priorityOrder[b.priority] ?? 1)
      case 'progress': return goalProgress(b) - goalProgress(a)
      case 'date': return (a.target_date || 'z').localeCompare(b.target_date || 'z')
      default: return a.name.localeCompare(b.name)
    }
  })
})

const completedGoals = computed(() =>
  goals.value.filter(g => g.current_amount >= g.target_amount)
)

const totalCurrent = computed(() =>
  goals.value.reduce((sum, g) => sum + (g.current_amount || 0), 0)
)

const totalTarget = computed(() =>
  goals.value.reduce((sum, g) => sum + (g.target_amount || 0), 0)
)

const overallProgress = computed(() => {
  if (!totalTarget.value) return 0
  return Math.round((totalCurrent.value / totalTarget.value) * 100)
})

function goalProgress(goal) {
  if (!goal.target_amount) return 0
  return Math.round((goal.current_amount / goal.target_amount) * 100)
}

function monthsRemaining(goal) {
  if (!goal.target_date) return null
  const target = new Date(goal.target_date)
  const now = new Date()
  const months = (target.getFullYear() - now.getFullYear()) * 12 + (target.getMonth() - now.getMonth())
  return months > 0 ? months : null
}

function formatDate(dateStr) {
  if (!dateStr) return ''
  return new Date(dateStr).toLocaleDateString('es-CO', { month: 'long', year: 'numeric' })
}

function formatMoney(amount) {
  if (!amount && amount !== 0) return '0'
  return new Intl.NumberFormat('es-CO').format(amount)
}

function openContribution(goal) {
  selectedGoal.value = goal
  contributionAmount.value = ''
  contributionDate.value = new Date().toISOString().split('T')[0]
  contributionError.value = ''
  showContributionModal.value = true
  nextTick(() => contributionField.value?.focus())
}

function closeContribution() {
  showContributionModal.value = false
  selectedGoal.value = null
  contributionAmount.value = ''
  contributionError.value = ''
}

function validateContribution() {
  const val = parseFloat(contributionAmount.value)
  if (isNaN(val) || val <= 0) {
    contributionError.value = 'El monto debe ser mayor a $0'
  } else if (val > 100000000) {
    contributionError.value = 'El monto es demasiado alto'
  } else {
    contributionError.value = ''
  }
}

function openCreateModal() {
  newGoal.value = {
    name: '',
    target_amount: '',
    monthly_contribution: '',
    target_date: '',
    goal_type: 'savings',
    expected_return_rate: '',
    horizon_months: '',
    priority: 'medium',
  }
  showCreateModal.value = true
}

function closeCreateModal() {
  showCreateModal.value = false
}

async function submitCreateGoal() {
  if (!newGoal.value.name || !newGoal.value.target_amount) return
  creating.value = true
  try {
    const payload = {
      name: newGoal.value.name,
      target_amount: parseFloat(newGoal.value.target_amount),
      priority: newGoal.value.priority,
      goal_type: newGoal.value.goal_type,
    }
    if (newGoal.value.monthly_contribution) payload.monthly_contribution = parseFloat(newGoal.value.monthly_contribution)
    if (newGoal.value.target_date) payload.target_date = newGoal.value.target_date
    if (newGoal.value.goal_type === 'investment') {
      if (newGoal.value.expected_return_rate) payload.expected_return_rate = parseFloat(newGoal.value.expected_return_rate)
      if (newGoal.value.horizon_months) payload.horizon_months = parseInt(newGoal.value.horizon_months)
    }
    await api.post('/savings/goals', payload)
    closeCreateModal()
    await loadData()
    window.$toast?.success('Meta creada')
  } catch (e) {
    window.$toast?.error('No pudimos crear la meta. Intenta de nuevo.')
  } finally {
    creating.value = false
  }
}

function toggleDetails(goal) {
  if (expandedGoal.value?.id === goal.id) {
    expandedGoal.value = null
  } else {
    expandedGoal.value = goal
    if (!goal.history) loadGoalHistory(goal)
  }
}

async function loadGoalHistory(goal) {
  try {
    const res = await api.get(`/savings/goals/${goal.id}/contributions`)
    goal.history = res.data
  } catch {
    goal.history = []
  }
}

function openEditModal(goal) {
  editingGoal.value = goal
  editForm.value = {
    name: goal.name,
    target_amount: goal.target_amount,
    monthly_contribution: goal.monthly_contribution || '',
    target_date: goal.target_date || '',
    priority: goal.priority || 'medium',
    goal_type: goal.goal_type || 'savings',
  }
  showEditModal.value = true
}

function closeEditModal() {
  showEditModal.value = false
  editingGoal.value = null
}

async function submitEditGoal() {
  if (!editingGoal.value) return
  editing.value = true
  try {
    const payload = {
      name: editForm.value.name,
      target_amount: parseFloat(editForm.value.target_amount),
      priority: editForm.value.priority,
      goal_type: editForm.value.goal_type,
    }
    if (editForm.value.monthly_contribution) payload.monthly_contribution = parseFloat(editForm.value.monthly_contribution)
    if (editForm.value.target_date) payload.target_date = editForm.value.target_date
    await api.put(`/savings/goals/${editingGoal.value.id}`, payload)
    closeEditModal()
    await loadData()
    window.$toast?.success('Meta actualizada')
  } catch {
    window.$toast?.error('No pudimos guardar los cambios. Intenta de nuevo.')
  } finally {
    editing.value = false
  }
}

function confirmDelete(goal) {
  deletingGoal.value = goal
  showDeleteConfirm.value = true
}

async function submitDeleteGoal() {
  if (!deletingGoal.value) return
  deleting.value = true
  try {
    await api.delete(`/savings/goals/${deletingGoal.value.id}`)
    showDeleteConfirm.value = false
    deletingGoal.value = null
    expandedGoal.value = null
    await loadData()
    window.$toast?.success('Meta eliminada')
  } catch {
    window.$toast?.error('No pudimos eliminar la meta. Intenta de nuevo.')
  } finally {
    deleting.value = false
  }
}

async function submitContribution() {
  if (!selectedGoal.value || !contributionAmount.value || contributionError.value) return
  contributing.value = true
  try {
    const amount = parseFloat(contributionAmount.value)
    await api.post(`/savings/goals/${selectedGoal.value.id}/contributions`, {
      amount,
      contribution_date: contributionDate.value,
    })
    const goal = goals.value.find(g => g.id === selectedGoal.value.id)
    if (goal) goal.current_amount += amount
    closeContribution()
    window.$toast?.success('Aporte registrado')
    setTimeout(() => loadData(), 600)
  } catch {
    window.$toast?.error('No pudimos registrar el aporte. Intenta de nuevo.')
  } finally {
    contributing.value = false
  }
}

async function loadData() {
  loading.value = true
  error.value = null
  try {
    const res = await api.get('/savings/goals')
    goals.value = res.data
  } catch {
    error.value = 'No pudimos cargar tus metas. Comprueba tu conexión.'
  } finally {
    loading.value = false
  }
}

async function handleGoalCreated() {
  const prevIds = goals.value.map(g => g.id)
  await loadData()
  const newGoal = goals.value.find(g => !prevIds.includes(g.id))
  if (newGoal) {
    highlightedGoalId.value = newGoal.id
    setTimeout(() => {
      const el = document.querySelector(`[data-goal-id="${newGoal.id}"]`)
      el?.scrollIntoView({ behavior: 'smooth', block: 'center' })
    }, 100)
    setTimeout(() => { highlightedGoalId.value = null }, 2000)
  }
}

onMounted(() => {
  loadData()
  window.addEventListener('goal-created', handleGoalCreated)
})

onUnmounted(() => {
  window.removeEventListener('goal-created', handleGoalCreated)
})
</script>

