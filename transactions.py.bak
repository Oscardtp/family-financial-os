from decimal import Decimal
from fastapi import APIRouter, Depends, HTTPException, Query
from datetime import date
from sqlalchemy.ext.asyncio import AsyncSession
from app.database import get_db
from app.presentation.deps import require_viewer, require_member, require_owner
from app.presentation.schemas.schemas import (
    TransactionCreate, TransactionResponse,
)
from app.infrastructure.repositories.transaction_repository import SQLAlchemyTransactionRepository
from app.infrastructure.repositories.account_repository import SQLAlchemyAccountRepository
from app.infrastructure.repositories.category_repository import SQLAlchemyCategoryRepository
from app.presentation.audit_helper import log_action

router = APIRouter(prefix="/transactions", tags=["Transactions"])


@router.get("", response_model=list[TransactionResponse], summary="List transactions", description="Returns all transactions with optional filters")
async def list_transactions(
    account_id: str | None = None,
    category_id: str | None = None,
    date_from: date | None = None,
    date_to: date | None = None,
    skip: int = 0,
    limit: int = 100,
    current_user: dict = Depends(require_viewer),
    db: AsyncSession = Depends(get_db),
):
    repo = SQLAlchemyTransactionRepository(db)
    return await repo.get_all(
        household_id=current_user["household_id"],
        account_id=account_id,
        category_id=category_id,
        date_from=date_from,
        date_to=date_to,
        skip=skip,
        limit=limit,
    )


@router.post("", response_model=TransactionResponse, status_code=201, summary="Create transaction", description="Record a new income, expense, or transfer")
async def create_transaction(
    data: TransactionCreate,
    current_user: dict = Depends(require_member),
    db: AsyncSession = Depends(get_db),
):
    account_repo = SQLAlchemyAccountRepository(db)
    account = await account_repo.get_by_id(data.account_id)
    if not account or account["household_id"] != current_user["household_id"]:
        raise HTTPException(status_code=404, detail="Account not found")

    if data.type == "transfer" and not data.to_account_id:
        raise HTTPException(
            status_code=400,
            detail="Las transferencias requieren una cuenta de destino (to_account_id)"
        )

    if data.type == "transfer" and data.to_account_id and data.account_id == data.to_account_id:
        raise HTTPException(
            status_code=400,
            detail="No se puede transferir a la misma cuenta"
        )

    household_id = current_user["household_id"]
    if data.category_id:
        cat_repo = SQLAlchemyCategoryRepository(db)
        category = await cat_repo.get_by_id(data.category_id)
        if not category or category.get("household_id") != household_id:
            raise HTTPException(status_code=404, detail="Category not found")
        if category["type"] != data.type:
            raise HTTPException(
                status_code=400,
                detail=f"Categoría '{category['name']}' es de tipo '{category['type']}', "
                       f"pero se envió tipo '{data.type}'. Use la categoría correcta.",
            )

    if data.type == "transfer" and data.to_account_id:
        to_account = await account_repo.get_by_id(data.to_account_id)
        if not to_account or to_account["household_id"] != household_id:
            raise HTTPException(status_code=404, detail="Destination account not found")

    tx_repo = SQLAlchemyTransactionRepository(db)

    if data.type == "expense" and account["type"] != "credit_card":
        if account["balance"] < Decimal(str(data.amount)):
            raise HTTPException(
                status_code=400,
                detail=f"Saldo insuficiente. Disponible: ${account['balance']:,.2f}, requerido: ${Decimal(str(data.amount)):,.2f}",
            )

    if data.type == "transfer" and data.to_account_id:
        if account["type"] != "credit_card" and account["balance"] < Decimal(str(data.amount)):
            raise HTTPException(
                status_code=400,
                detail=f"Saldo insuficiente en cuenta origen. Disponible: ${account['balance']:,.2f}, requerido: ${Decimal(str(data.amount)):,.2f}",
            )

    transaction = await tx_repo.create({
        "account_id": data.account_id,
        "category_id": data.category_id,
        "user_id": current_user["id"],
        "type": data.type,
        "amount": Decimal(str(data.amount)),
        "description": data.description,
        "date": data.date,
        "to_account_id": data.to_account_id,
    })

    if data.type == "income":
        await account_repo.update_balance(data.account_id, Decimal(str(data.amount)))
    elif data.type == "expense":
        deducted = await account_repo.deduct_balance(data.account_id, Decimal(str(data.amount)))
        if not deducted:
            await tx_repo.delete(transaction["id"])
            raise HTTPException(
                status_code=400,
                detail=f"Saldo insuficiente. Disponible: ${account['balance']:,.2f}, requerido: ${Decimal(str(data.amount)):,.2f}",
            )
    elif data.type == "transfer" and data.to_account_id:
        deducted = await account_repo.deduct_balance(data.account_id, Decimal(str(data.amount)))
        if not deducted:
            await tx_repo.delete(transaction["id"])
            raise HTTPException(
                status_code=400,
                detail=f"Saldo insuficiente en cuenta origen. Disponible: ${account['balance']:,.2f}, requerido: ${Decimal(str(data.amount)):,.2f}",
            )
        await account_repo.update_balance(data.to_account_id, Decimal(str(data.amount)))

    await log_action(
        db, current_user["household_id"], current_user["id"], current_user["email"],
        "create", "transaction", transaction["id"], data.description,
    )
    return transaction


@router.delete("/{transaction_id}", status_code=204, summary="Delete transaction", description="Remove a transaction record")
async def delete_transaction(
    transaction_id: str,
    current_user: dict = Depends(require_owner),
    db: AsyncSession = Depends(get_db),
):
    tx_repo = SQLAlchemyTransactionRepository(db)
    transaction = await tx_repo.get_by_id(transaction_id)
    if not transaction:
        raise HTTPException(status_code=404, detail="Transaction not found")

    account_repo = SQLAlchemyAccountRepository(db)
    account = await account_repo.get_by_id(transaction["account_id"])
    if not account or account["household_id"] != current_user["household_id"]:
        raise HTTPException(status_code=404, detail="Transaction not found")

    if transaction["type"] == "income":
        await account_repo.update_balance(transaction["account_id"], -transaction["amount"])
    elif transaction["type"] == "expense":
        await account_repo.update_balance(transaction["account_id"], transaction["amount"])
    elif transaction["type"] == "transfer" and transaction.get("to_account_id"):
        await account_repo.update_balance(transaction["account_id"], transaction["amount"])
        await account_repo.update_balance(transaction["to_account_id"], -transaction["amount"])

    await tx_repo.delete(transaction_id)
    await log_action(
        db, current_user["household_id"], current_user["id"], current_user["email"],
        "delete", "transaction", transaction_id, transaction.get("description"),
    )
